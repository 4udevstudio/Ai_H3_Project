# ========================================
# MiniMax H3 Studio Backend Environment
# ========================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ตามเครื่องของแต่ละคน
# ไฟล์ .env ต้องไม่ถูก commit เข้า Git

# ========================================
# FFmpeg / FFprobe paths
# ========================================
# ถ้า FC ติดตั้ง ffmpeg แบบ system และอยู่ใน PATH แล้ว
# สามารถเว้นว่างไว้ได้ ระบบจะ fallback ไปหาอัตโนมัติ
#
# แต่ถ้า ffmpeg อยู่คนละที่ เช่น:
#   C:\Users\COM-1\bin\ffmpeg.exe
#   C:\Users\COM-1\bin\ffprobe.exe
# ให้อ้าง path เต็มตรงนี้

H3_FFMPEG_PATH=C:\Users\COM-1\bin\ffmpeg.exe
H3_FFPROBE_PATH=C:\Users\COM-1\bin\ffprobe.exe

# ========================================
# ComfyUI paths
# ========================================
# ถ้าต่างจาก default ใน config.py ให้อ้างตรงนี้
# COMFYUI_ROOT=D:\ComfyUI_windows_portable
# COMFYUI_API_BASE_URL=http://127.0.0.1:8188
# COMFYUI_INPUT_DIR=D:\ComfyUI_windows_portable\ComfyUI\input
# COMFYUI_OUTPUT_DIR=D:\ComfyUI_windows_portable\ComfyUI\output

# ========================================
# Project outputs
# ========================================
# OUTPUTS_DIR=D:\minimax-h3-studio\outputs
# WORKFLOWS_DIR=D:\minimax-h3-studio\backend\workflows

# ========================================
# LLM / Gemma (ถ้าใช้)
# ========================================
# LLM_MODEL_ID=google/gemma-3-4b-it
# LLM_IDLE_TIMEOUT_SECONDS=300