# Local default. Postgres in docker-compose.yml listens on 127.0.0.1 only.
# The password matches POSTGRES_PASSWORD when that variable is unset (reelfirepassword).
# Change both before a Cloudflare Tunnel or any non-local deploy.
DATABASE_URL="postgresql://reelfire:reelfirepassword@127.0.0.1:5432/reelfire?schema=public"

# Optional. Leave empty to get a one-time random admin password printed by the seed.
# If set, it must be at least 12 characters. Re-seeding never replaces an existing hash.
SEED_ADMIN_PASSWORD=

# Leave empty for local dev. Set a long random value before any tunneled deploy.
# Sent as X-Internal-Secret only when non-empty.
INTERNAL_API_SECRET=

# Next.js route handlers call FastAPI here. Default http://127.0.0.1:8000.
BACKEND_URL="http://127.0.0.1:8000"

# Host used in browser-facing *_url fields. Falls back to BACKEND_URL.
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000"
