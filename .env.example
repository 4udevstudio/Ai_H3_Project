# Placeholder credentials. They match docker-compose.yml.
# Point DATABASE_URL at your own Postgres to skip Docker in the install/start scripts.
DATABASE_URL="postgresql://reelfire:reelfirepassword@localhost:5432/reelfire?schema=public"

# Dev-only password for the seeded admin@reelfire.local user.
# Stored as a bcryptjs hash with 10 salt rounds. Change it before any shared deploy.
SEED_ADMIN_PASSWORD="changeme"

# Sent as X-Internal-Secret on server-side FastAPI calls when set. Placeholder only.
INTERNAL_API_SECRET="replace-with-a-long-random-string"

# Next.js route handlers call FastAPI here. Default http://127.0.0.1:8000.
BACKEND_URL="http://127.0.0.1:8000"

# Host used in browser-facing *_url fields. Falls back to BACKEND_URL.
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000"
